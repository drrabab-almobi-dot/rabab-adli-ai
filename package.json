{
  "name": "@workspace/adli-directory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "node scripts/check-emails.mjs && node scripts/audit-names.mjs && vite build --config vite.config.ts && node scripts/verify-build.mjs",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "check:emails": "node scripts/check-emails.mjs",
    "check:names": "node scripts/audit-names.mjs",
    "check:build": "node scripts/verify-build.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "vite": "^7.3.6"
  }
}
